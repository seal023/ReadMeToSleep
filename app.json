{
  "expo": {
    "name": "Read Me To Sleep",
    "slug": "readmetosleep",
    "version": "1.1.0",
    "privacy": "unlisted",
    "description": "AI bedtime stories for kids aged 3-8. Story themes you type are sent to our AI service to generate the story. Everything else stays on your device.",
    "orientation": "default",
    "scheme": "readmetosleep",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBEDE4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seal023.ReadMeToSleep",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Generate stories about your location (data stays on device)",
        "NSMicrophoneUsageDescription": "Record your child's stories (recordings stay on device)",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "aliyuncs.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "101"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFF5E6"
      },
      "package": "com.readmetosleep.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-file-system",
      "expo-audio",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "83135596-9191-45de-9cda-ce6facaba0f0"
      }
    },
    "owner": "xing_yufei"
  }
}
