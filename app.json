{
  "expo": {
    "name": "Read Me To Sleep",
    "slug": "readmetosleep",
    "version": "1.0.0",
    "privacy": "unlisted",
    "description": "AI bedtime stories for kids aged 3-8. Story themes you type are sent to our AI service to generate the story. Everything else stays on your device.",
    "orientation": "portrait",
    "scheme": "readmetosleep",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seal023.ReadMeToSleep",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Generate stories about your location (data stays on device)",
        "NSMicrophoneUsageDescription": "Record your child's stories (recordings stay on device)",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF5E6"
      },
      "package": "com.readmetosleep.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-file-system",
      "expo-audio"
    ]
  }
}
