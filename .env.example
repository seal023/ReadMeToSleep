# 阿里云百炼（Bailian）MaaS 配置模板
# 复制本文件为 .env 并填入真实 Key；.env 已被 .gitignore 忽略，不会提交
#
# Xcode Cloud / EBA 云端构建：
#   不要提交 .env。改为在 App Store Connect → Xcode Cloud 工作流
#   → Environment Variables 里配置下面同名变量（建议全部标记为 Secret）。
#   ci_post_clone.sh 会在云端 checkout 后自动用这些值重新生成 .env。
#
# 若某个变量未配置，应用层会降级：
#   AI key 缺失 → generateStory 降级到内置 100 篇故事库，不会崩

# ── AI 故事生成（qwen-plus） ─────────────────────────────
# Key 有两种合法形态：
#   ① 传统 Key：sk- + 32 位（35 字符），任何站点都认
#   ② 业务空间专属 Key：sk-ws-…（约 100-130 字符），只能配它所属 workspace 的专属域名
EXPO_PUBLIC_AI_API_KEY=sk-ws-xxxx
# Base URL 两种写法都行（代码只取协议+主机，路径自己拼，不会出现双份路径）：
#   只到主机：    https://ws-<id>.<region>.maas.aliyuncs.com
#   带版本路径：  https://ws-<id>.<region>.maas.aliyuncs.com/compatible-mode/v1
# ⚠️ 这里必须是「与上面 Key 同一个业务空间」的域名，否则 403 Workspace endpoint access denied。
EXPO_PUBLIC_AI_BASE_URL=

# ── 语音合成 / 声音克隆 ─────────────────────────────────
# 声音复刻（家长音色注册）端点；留空则基于 AI_BASE_URL 自动拼 customization 路径
EXPO_PUBLIC_VOICE_ENROLL_URL=
# 百炼业务空间 ID（形如 ws-xxxxxxxxxxxxxxxx）。
# ★ 务必填对：Base URL 缺失时用它推导专属域名；Base URL 里的空间与它不一致时，
#   以它为准自动纠正（Key 只认自己所属空间的域名）。
EXPO_PUBLIC_VOICE_WORKSPACE_ID=
# 复刻目标模型（注册 create_voice 的 target_model），默认 qwen-audio-3.0-tts-flash。
# ⚠️ 克隆音色会绑定在该模型上，合成必须用同一模型，否则 Model not exist。
EXPO_PUBLIC_VOICE_TARGET_MODEL=qwen-audio-3.0-tts-flash
# 合成专用端点（可选）：默认与注册共用同一 workspace（克隆音色就注册在那里，
#   必须同 workspace 才能找到）。仅在注册/合成必须分属不同地域 workspace 时才设置，
#   且务必指向与注册同一个 workspace，否则找不到克隆音色而报 Model not exist。
EXPO_PUBLIC_VOICE_SYNTH_URL=
# 合成模型名（已废弃，不再使用）：合成 model 现在强制等于复刻 target_model，
# 以保证一致。保留此变量仅为兼容，代码不再读取它。
EXPO_PUBLIC_VOICE_SYNTH_MODEL=cosyvoice-v2
# DashScope 国际站 TTS 端点（可选，预留）
EXPO_PUBLIC_TTS_BASE_URL=

# ── 账号登录（Supabase） ─────────────────────────────────
# 用于「Sign in with Apple」与「邮件验证码」两种登录，并持久化会话。
# 未配置时 App 仍可正常使用（本地模式），只是登录入口提示「账号服务尚未配置」。
# anon key 是设计上可暴露在前端的公开密钥，真正的权限靠 RLS 控制，不是服务端密钥。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
